# Copie este arquivo para .env e ajuste os valores se precisar.

# Endereço da TBOTT_api (back-end). Em desenvolvimento, a API roda na porta 8000.
VITE_API_URL=http://localhost:8000

# Atenção: toda variável que começa com VITE_ fica visível no navegador.
# Nunca coloque aqui DATABASE_URL, senhas ou chaves secretas (como SUPABASE_SECRET_KEY).
